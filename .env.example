# Supabase project settings — see planning/00-overview.md and planning/03-data-model-and-infra.md
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (Supabase project settings → Database → Connection string → asyncpg-style)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres

# Figma OAuth (account-linking flow, planning/01-auth.md; import path, planning/05).
# See docs/figma-setup.md for how to create the app and get these. Leave unset to
# disable the connect/import routes (they 503 instead of failing at import time).
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:8000/api/v1/auth/figma/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIGMA_TOKEN_ENCRYPTION_KEY=

# Stimulus Engine's VisionProvider (planning/05) and Insight Engine's InsightProvider
# (planning/11) model calls — read directly by Pydantic AI, not by app/core/settings.py.
# Required for settings.vision_model/settings.insight_model's defaults ("openrouter:...")
# to actually work; get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
