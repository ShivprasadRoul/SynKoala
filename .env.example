# Supabase project settings — see planning/00-overview.md and planning/03-data-model-and-infra.md
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (Supabase project settings → Database → Connection string → asyncpg-style)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres

# Figma OAuth (account-linking flow, planning/01-auth.md) — optional until the
# Stimulus Engine's Figma import path is built. Leave unset to disable those routes.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:8000/api/v1/auth/figma/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIGMA_TOKEN_ENCRYPTION_KEY=
